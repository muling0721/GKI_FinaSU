# ==================== 自定义提交配置 ====================
# 本文件用于配置 SUSFS 仓库的自定义提交
#
# 使用说明:
#   1. 将 custom 设为 true 启用自定义提交功能
#   2. 在对应配置项后填入想要使用的 commit hash
#   3. 留空表示使用该分支的最新提交
#
# 示例:
#   gki-android14-6.1=abc123def456
#
# ================================================================

# 是否启用自定义提交 (true/false)
custom=false

# ==================== SUSFS 各分支的 commit hash ====================
# 仅当 custom=true 时生效；当前 custom=false，SUSFS 跟随各分支最新提交。
# 需要锁定/回退时把 custom 改回 true，即使用下方快照：
# 统一锁定到 2026-11-09 22:16:14 +0800 的快照（各分支该时刻及之前的
# 最后一个提交，均为 "KernelSU: Sync with upstream"）。
#
# 选点依据：
#   1. 全部 7 个分支在该提交上的 ksu_module_susfs/module.prop 均为
#      version=v2.4.0 / versionCode=204000，锁定后 Release 显示的版本
#      与构建源码严格一致；
#   2. 该快照晚于上游 "Bump version to 2.4.0"（2026-11-08），可避免
#      跌回到旧版本，同时不跟随之后的漂移，降低补丁上下文失配风险。
